# The pin, in one place: which release, from where, with which checksum, and
# where it is unpacked to. Sourced by both install.sh (which downloads it)
# and activate.sh (which puts it on PATH), so the two can never drift apart.
#
# Not a script: no shebang, no logic -- just the four values the two scripts
# share. This file is the hand-rolled equivalent of a conan recipe's
# conandata.yml (see ../conan/recipes/cmake/3.31.9/conandata.yml).

NVIM_VERSION="0.12.4"
NVIM_URL="https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-x86_64.tar.gz"
NVIM_SHA256="012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628"

# DENVER_ENV_WORKDIR is denver's own state dir for this env
# (examples/howto-env/.denver/denver/ by default): per environment, never
# shared, and -- because it lives inside the env dir, which the compose file
# bind-mounts -- it survives the --rm container, so the download happens once
# rather than on every run. The version is part of the path, so bumping
# NVIM_VERSION installs next to the old one instead of on top of it.
NVIM_PREFIX="${DENVER_ENV_WORKDIR}/nvim/${NVIM_VERSION}"
