+void
+Config::set_read_only_dirs(const std::vector<std::filesystem::path>& value)
+{
+  m_read_only_dirs.clear();
+  for (const auto& path : value) {
+    verify_absolute_path(path);
+    m_read_only_dirs.push_back(util::lexically_normal(path));
+  }
+}
